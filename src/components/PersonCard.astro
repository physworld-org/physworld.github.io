---
interface Props {
  name: string;
  affiliation: string;
  image?: string;
  initials?: string;
  tag?: string;
  focus?: string;
  url?: string;
  class?: string;
}
const { name, affiliation, image, initials, tag, focus, url, class: className = "" } = Astro.props;
---

<article class:list={["person-card", className]}>
  <div class="avatar-ring">
    {image ? (
      <img class="avatar" src={image} alt={name} loading="eager" decoding="async" />
    ) : (
      <div class="avatar avatar-fallback" aria-hidden="true">{initials ?? name.split(" ").map((part) => part[0]).join("").slice(0, 2)}</div>
    )}
  </div>
  <div class="person-meta">
    {tag && <span class="person-tag">{tag}</span>}
    {url ? (
      <h3><a href={url} target="_blank" rel="noopener noreferrer">{name}</a></h3>
    ) : (
      <h3>{name}</h3>
    )}
    <p class="affiliation">{affiliation}</p>
    {focus && <p class="focus">{focus}</p>}
  </div>
</article>

<style>
  .person-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 260px;
    min-height: 360px;
    flex-shrink: 0;
    padding: 1.6rem 1.2rem;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: all var(--transition);
    cursor: default;
  }

  .person-card:hover {
    transform: translateY(-4px);
    background: var(--glass-hover);
    border-color: rgba(243, 179, 93, 0.28);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.3),
                0 0 30px var(--accent-glow);
  }

  .person-card.speaker-card-large {
    width: 100%;
    min-height: 376px;
    padding: 2.05rem 1.3rem 1.45rem;
  }

  .avatar-ring {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    padding: 3px;
    background: linear-gradient(135deg, var(--accent) 0%, var(--mint) 100%);
    margin-bottom: 1.25rem;
    transition: all var(--transition);
    flex-shrink: 0;
  }

  .person-card:hover .avatar-ring {
    box-shadow: 0 0 24px var(--accent-glow);
  }

  .person-card.speaker-card-large .avatar-ring {
    width: 120px;
    height: 120px;
    margin-bottom: 1.3rem;
  }

  .avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    border: 3px solid var(--bg-base);
  }

  .avatar-fallback {
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, rgba(243, 179, 93, 0.18), rgba(105, 214, 200, 0.16));
    color: var(--accent-bright);
    font-weight: 700;
    font-size: 1.65rem;
    letter-spacing: 0;
  }

  .person-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .person-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 1.5rem;
    padding: 0.18rem 0.55rem;
    margin-bottom: 0.55rem;
    border: 1px solid rgba(105, 214, 200, 0.24);
    border-radius: 999px;
    color: var(--mint);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .person-meta h3 {
    font-family: var(--font-body);
    font-size: 1.08rem;
    font-weight: 600;
    margin-bottom: 0.3rem;
  }

  .person-card.speaker-card-large .person-meta h3 {
    font-size: 1.14rem;
  }

  .person-meta h3 a {
    color: var(--text);
    text-decoration: none;
    transition: color var(--transition);
  }

  .person-meta h3 a:hover {
    color: var(--accent-bright);
  }

  .affiliation {
    color: var(--text-muted);
    font-size: 0.88rem;
    font-weight: 400;
    line-height: 1.45;
  }

  .focus {
    margin-top: 0.85rem;
    color: var(--text-secondary);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .person-card.speaker-card-large .affiliation,
  .person-card.speaker-card-large .focus {
    max-width: 292px;
  }
</style>
