---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Workshop Proposal | PhysWorld" description="PhysWorld workshop proposal: Physical World Understanding through geometry, characteristics, and multimodal sensing.">
  <Nav currentPage="/cfp" />

  <!-- Mini Hero -->
  <section class="hero-small">
    <div class="hero-small-bg" aria-hidden="true"></div>
    <div class="hero-small-content container">
      <p class="eyebrow reveal">NeurIPS 2026 workshop proposal</p>
      <h1 class="reveal">Workshop Proposal</h1>
      <p class="lead reveal">
        The 1st Workshop on Physical World Understanding: Geometry, Characteristics, and Multimodal Sensing.
      </p>
      <div class="cta-row reveal">
        <a class="btn ghost" href="/#organizers">Organizers</a>
        <a class="btn ghost" href="/#contact">Contact</a>
      </div>
    </div>
  </section>

  <!-- Overview -->
  <section class="section">
    <div class="container">
      <SectionHeading title="Proposal Summary" />
      <div class="glass reveal cfp-body">
        <p>
          <strong>Tagline:</strong> Beyond Pixels: Understanding the Physical World through Geometry,
          Dynamics, and Multimodal Sensing.
        </p>
        <p>
          Modern computer vision and embodied AI systems must act in the physical world, not merely describe it.
          PhysWorld proposes a shared forum for researchers working on structure, dynamics, materials, and
          non-RGB sensing to define common benchmarks, evaluation protocols, and research questions.
        </p>
        <p>
          The workshop is organized around three coupled pillars: physical geometry, physical characteristics,
          and physical sensors. It connects computer vision, robotics, graphics, multimodal learning, haptics,
          audio, and physics-based simulation.
        </p>
        <ul class="bullets">
          <li><strong>Format:</strong> Proposed full-day workshop with invited talks, moderated Q&A, contributed-paper orals, posters, live demos, and a synthesis panel.</li>
          <li><strong>Submissions:</strong> Long papers up to 8 pages and extended abstracts up to 4 pages in NeurIPS 2026 style.</li>
          <li><strong>Review:</strong> Double-blind review via OpenReview with at least 3 reviewers per paper.</li>
          <li><strong>Archival status:</strong> Non-archival; accepted papers may be posted on the workshop website.</li>
          <li><strong>Key dates:</strong> Submission 2026-09-08; notification 2026-09-29; camera-ready 2026-12-08.</li>
        </ul>
        <p class="closing">The proposal is a living draft and public workshop details will be updated after decisions are finalized.</p>
      </div>
    </div>
  </section>

  <!-- Topics -->
  <section class="section">
    <div class="container">
      <SectionHeading title="Topics of Interest" subtitle="From geometry to material properties and non-RGB sensing" />
      <div class="glass reveal cfp-body">
        <ul class="bullets">
          <li><strong>Physical Geometry:</strong> 3D/4D reconstruction, articulated and deformable scene understanding, geometry-aware world models, and physically grounded view synthesis.</li>
          <li><strong>Physical Characteristics:</strong> Material and physical property estimation, mass, friction, stiffness, elasticity, deformability, affordances, contact-rich interaction, and differentiable simulation.</li>
          <li><strong>Physical Sensors:</strong> Multimodal sensing and fusion with tactile, force/torque, proprioceptive, RF, audio, depth, IMU, and event-based signals.</li>
          <li><strong>Cross-cutting:</strong> Embodied world models, robot manipulation, sim-to-real transfer, multimodal simulators, benchmarks, datasets, evaluation protocols, and responsible deployment.</li>
        </ul>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="back-link reveal">
      <a href="/">Back to main site</a>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  /* Mini hero */
  .hero-small {
    position: relative;
    padding: 10rem 0 5rem;
    overflow: hidden;
    text-align: center;
  }

  .hero-small-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 20%, rgba(79, 164, 212, 0.1) 0%, transparent 70%);
    z-index: 0;
  }

  .hero-small-content {
    position: relative;
    z-index: 1;
    max-width: 760px;
  }

  .eyebrow {
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .hero-small h1 {
    margin-bottom: 1.25rem;
    background: linear-gradient(135deg, var(--text) 30%, var(--accent-bright) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lead {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 2rem;
    line-height: 1.75;
  }

  .cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* CFP Body */
  .cfp-body {
    max-width: 780px;
    margin: 0 auto;
  }
  .cfp-body p {
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }

  .bullets {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
  }
  .bullets li {
    position: relative;
    padding: 0.75rem 0 0.75rem 1.75rem;
    font-size: 1.02rem;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--glass-border);
    line-height: 1.7;
  }
  .bullets li:last-child {
    border-bottom: none;
  }
  .bullets li::before {
    content: "›";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
    font-size: 1.3rem;
    line-height: 1.5;
  }

  .closing {
    margin-top: 0.5rem;
    font-style: italic;
    color: var(--text-muted);
  }

  /* Contact card */
  .contact-card {
    text-align: center;
    max-width: 520px;
    margin: 0 auto;
  }
  .org-name {
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.35rem;
  }
  .email-link {
    font-size: 1.15rem;
    margin-bottom: 1.25rem;
  }
  .email-link a {
    font-weight: 600;
  }
  .closing-note {
    font-size: 0.92rem;
  }

  /* Back link */
  .back-link {
    padding: 2rem 0 1rem;
  }
  .back-link a {
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: color var(--transition);
  }
  .back-link a:hover {
    color: var(--accent-bright);
  }
</style>
