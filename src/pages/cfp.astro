---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/paths";
import { topics, workshop } from "../data/workshop";
---

<Layout title="Call for Papers | PhysWorldAI" description={workshop.tagline}>
  <Nav currentPage="/cfp" />

  <section class="hero-small">
    <div class="hero-small-bg" aria-hidden="true"></div>
    <div class="hero-small-content container">
      <p class="eyebrow reveal">NeurIPS 2026 Workshop | Atlanta, Georgia</p>
      <h1 class="reveal">Call for Papers</h1>
      <p class="lead reveal">{workshop.name}</p>
      <div class="cta-row reveal">
        <a class="btn ghost" href={withBase()}>Home</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading title="Topics of Interest" subtitle="From structure to material properties and non-RGB sensing" />
      <div class="topic-grid reveal-stagger">
        {topics.map((topic) => (
          <article class="topic-card">
            <h3>{topic.title}</h3>
            <p>{topic.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <SectionHeading title="Key Information" subtitle="Submission, review, and publication policy" />
      <div class="glass reveal cfp-body">
        <ul class="bullets">
          <li><strong>Submission format:</strong> {workshop.submissions}</li>
          <li><strong>Review process:</strong> {workshop.review}</li>
          <li><strong>Publication policy:</strong> {workshop.archivalStatus}</li>
          <li><strong>Dual submission:</strong> Concurrent submission to NeurIPS 2026 or other peer-reviewed venues is permitted if authors comply with those venues' policies.</li>
        </ul>
        <div class="date-grid">
          {workshop.dates.map((date) => (
            <div class="date-card">
              <span>{date.label}</span>
              <strong>{date.display}</strong>
            </div>
          ))}
        </div>
        <div class="submit-cta">
          <a class="btn primary" href={workshop.submissionUrl} target="_blank" rel="noopener noreferrer">
            View OpenReview venue
          </a>
          <p class="submit-note">Submissions for the NeurIPS 2026 workshop are closed.</p>
        </div>
      </div>

      <aside class="poster-panel reveal" aria-labelledby="poster-title" id="poster-session">
        <div class="poster-heading">
          <h3 id="poster-title">Poster Session</h3>
          <span class="poster-badge">Website only</span>
        </div>
        <p class="poster-format"><strong>Submission format:</strong> {workshop.submissions}</p>
        <p class="poster-policy"><strong>Publication policy:</strong> Accepted poster submissions will be hosted on the workshop website only.</p>
        <dl class="poster-dates">
          <div><dt>Submission deadline</dt><dd><time datetime="2026-10-29">October 29, 2026</time></dd></div>
          <div><dt>Notification</dt><dd><time datetime="2026-11-09">November 09, 2026</time></dd></div>
          <div><dt>Camera-ready</dt><dd><time datetime="2026-11-19">November 19, 2026</time></dd></div>
        </dl>
        <a class="poster-link" href="https://openreview.net/group?id=NeurIPS.cc/2026/Workshop/PhysWorldAI_Poster" target="_blank" rel="noopener noreferrer">View poster venue on OpenReview <span aria-hidden="true">↗</span></a>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading title="Awards and Support" subtitle="Sponsor support for the workshop" />
      <div class="glass reveal cfp-body">
        <ul class="bullets">
          <li><strong>2 NeurIPS A2077 Best Paper Awards</strong> (with Multiple Honorable Mentions)</li>
          <li><strong>1 NeurIPS Cyberbrain Best Paper Award</strong> (with Multiple Honorable Mentions)</li>
        </ul>
        <p>CyberBrain and 2077AI support the workshop.</p>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="back-link reveal">
      <a href={withBase()}>Back to main site</a>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  .hero-small {
    position: relative;
    padding: 10rem 0 5rem;
    overflow: hidden;
    text-align: center;
  }

  .hero-small-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgba(243, 179, 93, 0.11), transparent 42%),
      linear-gradient(225deg, rgba(154, 167, 255, 0.09), transparent 46%);
    z-index: 0;
  }

  .hero-small-content {
    position: relative;
    z-index: 1;
    max-width: 780px;
  }

  .eyebrow {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .hero-small h1 {
    margin-bottom: 1.25rem;
    background: linear-gradient(135deg, var(--text) 30%, var(--accent-bright) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lead {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 640px;
    margin: 0 auto 2rem;
    line-height: 1.75;
  }

  .cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .section-alt {
    background: rgba(255, 255, 255, 0.018);
    border-block: 1px solid rgba(255, 255, 255, 0.035);
  }

  .cfp-body {
    max-width: 860px;
    margin: 0 auto;
  }
  .cfp-body p {
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }

  .poster-panel {
    max-width: 740px;
    margin: 1.75rem auto 0;
    padding: 1.4rem 1.6rem;
    border: 1px solid rgba(154, 167, 255, 0.2);
    border-left: 3px solid var(--violet);
    border-radius: var(--radius);
    background: rgba(154, 167, 255, 0.025);
  }
  .poster-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: .8rem; }
  .poster-heading h3 { font-family: var(--font-body); font-size: 1.05rem; color: var(--text); }
  .poster-badge { color: var(--violet); font-size: .68rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; padding: .2rem .55rem; border: 1px solid rgba(154, 167, 255, .25); border-radius: 4px; white-space: nowrap; }
  .poster-panel p { font-size: .86rem; line-height: 1.65; margin: 0 0 .55rem; }
  .poster-dates { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin: 1rem 0; padding: .9rem 0; border-block: 1px solid rgba(154, 167, 255, .12); }
  .poster-dates dt { color: var(--text-muted); font-size: .72rem; margin-bottom: .25rem; }
  .poster-dates dd { color: var(--text); font-size: .88rem; font-weight: 600; }
  .poster-link { color: var(--violet); font-size: .83rem; font-weight: 600; }
  .poster-link:hover { color: var(--mint); }
  .poster-link:focus-visible { outline: 2px solid var(--violet); outline-offset: 4px; }
  @media(max-width:620px) { .poster-panel { padding: 1.1rem; } .poster-dates { grid-template-columns: 1fr; gap: .7rem; } .poster-dates > div { display: flex; justify-content: space-between; gap: 1rem; } }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 1.5rem;
  }
  .facts-grid div,
  .date-card,
  .topic-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    padding: 1rem;
  }
  .facts-grid strong,
  .date-card span {
    display: block;
    color: var(--text-muted);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.35rem;
  }
  .facts-grid span,
  .date-card strong {
    color: var(--accent-bright);
    font-size: 1rem;
    font-weight: 800;
  }

  .bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
  }
  .bullets li {
    position: relative;
    padding: 0.75rem 0 0.75rem 1.6rem;
    font-size: 1rem;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--glass-border);
    line-height: 1.7;
  }
  .bullets li:last-child {
    border-bottom: none;
  }
  .bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.38rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .date-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .submit-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.6rem;
  }
  .submit-note {
    margin: 0;
    color: var(--text-secondary);
    font-size: 1.15rem;
    text-align: center;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .topic-card h3 {
    font-family: var(--font-body);
    color: var(--accent-bright);
    font-size: 1rem;
    margin-bottom: 0.65rem;
  }
  .topic-card p {
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .back-link {
    padding: 2rem 0 1rem;
  }
  .back-link a {
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: color var(--transition);
  }
  .back-link a:hover {
    color: var(--accent-bright);
  }

  @media (max-width: 900px) {
    .facts-grid,
    .topic-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 620px) {
    .facts-grid,
    .date-grid,
    .topic-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
