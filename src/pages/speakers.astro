---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/paths";
import { schedule, speakers, workshop } from "../data/workshop";

const speakerCards = speakers.map((speaker) => ({
  ...speaker,
  image: withBase(speaker.image),
}));
---

<Layout title="Invited Speakers | PhysWorldAI" description="Invited speaker plan for the PhysWorldAI workshop proposal.">
  <Nav currentPage="/speakers" />

  <section class="hero-small">
    <div class="hero-small-bg" aria-hidden="true"></div>
    <div class="hero-small-content container">
      <p class="eyebrow reveal">Final proposal speaker plan</p>
      <h1 class="reveal">Invited Speakers</h1>
      <p class="lead reveal">
        The proposal plans four invited speakers spanning physical simulation, 3D/4D geometry, embodied intelligence,
        robot learning, and multimodal perception.
      </p>
      <div class="cta-row reveal">
        <a class="btn ghost" href={withBase()}>Home</a>
        <a class="btn ghost" href={withBase("cfp")}>Proposal</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading title="Speaker Lineup" subtitle="Planned invited speakers listed in the final PDF" />
      <div class="speaker-grid reveal-stagger">
        {speakerCards.map((speaker) => (
          <article class="speaker-card">
            <a class="speaker-image" href={speaker.url} target="_blank" rel="noopener noreferrer">
              <img src={speaker.image} alt={speaker.name} loading="lazy" />
            </a>
            <div class="speaker-body">
              <span class="speaker-pillar">{speaker.pillar}</span>
              <h3><a href={speaker.url} target="_blank" rel="noopener noreferrer">{speaker.name}</a></h3>
              <p class="speaker-title">{speaker.title}</p>
              <p class="speaker-affiliation">{speaker.affiliation}</p>
              <p class="speaker-bio">{speaker.bio}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <SectionHeading title="Program Flow" subtitle={`${workshop.format} workshop with moderated Q&A and live demos`} />
      <div class="schedule-list reveal">
        {schedule.map((item) => (
          <div class="schedule-item">
            <time>{item.time}</time>
            <div>
              <h3>{item.title}</h3>
              {item.detail && <p>{item.detail}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="container">
    <div class="back-link reveal">
      <a href={withBase()}>Back to main site</a>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  .hero-small {
    position: relative;
    padding: 10rem 0 5rem;
    overflow: hidden;
    text-align: center;
  }

  .hero-small-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgba(243, 179, 93, 0.11), transparent 42%),
      linear-gradient(225deg, rgba(105, 214, 200, 0.09), transparent 46%);
    z-index: 0;
  }

  .hero-small-content {
    position: relative;
    z-index: 1;
    max-width: 780px;
  }

  .eyebrow {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .hero-small h1 {
    margin-bottom: 1.25rem;
    background: linear-gradient(135deg, var(--text) 25%, var(--accent-bright) 72%, var(--mint) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lead {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 640px;
    margin: 0 auto 2rem;
    line-height: 1.75;
  }

  .cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .section-alt {
    background: rgba(255, 255, 255, 0.018);
    border-block: 1px solid rgba(255, 255, 255, 0.035);
  }

  .speaker-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .speaker-card {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 1.2rem;
    min-height: 280px;
    padding: 1rem;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    transition: transform var(--transition), border-color var(--transition), background var(--transition);
  }
  .speaker-card:hover {
    transform: translateY(-4px);
    background: var(--glass-hover);
    border-color: rgba(243, 179, 93, 0.26);
  }

  .speaker-image {
    display: block;
    width: 100%;
    min-height: 240px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
  }
  .speaker-image img {
    width: 100%;
    height: 100%;
    min-height: 240px;
    object-fit: cover;
    display: block;
  }

  .speaker-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .speaker-pillar {
    align-self: flex-start;
    color: var(--mint);
    border: 1px solid rgba(105, 214, 200, 0.24);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }

  .speaker-body h3 {
    font-family: var(--font-display);
    font-size: 1.55rem;
    margin-bottom: 0.45rem;
  }
  .speaker-body h3 a {
    color: var(--text);
  }
  .speaker-body h3 a:hover {
    color: var(--accent-bright);
  }

  .speaker-title {
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.96rem;
    line-height: 1.5;
    margin-bottom: 0.25rem;
  }

  .speaker-affiliation {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.85rem;
  }

  .speaker-bio {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .schedule-list {
    max-width: 860px;
    margin: 0 auto;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--glass);
  }

  .schedule-item {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 1.25rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--glass-border);
    align-items: center;
  }
  .schedule-item:last-child {
    border-bottom: none;
  }
  .schedule-item time {
    color: var(--accent-bright);
    font-weight: 800;
    font-size: 0.95rem;
  }
  .schedule-item h3 {
    font-family: var(--font-body);
    font-size: 1rem;
    margin-bottom: 0.1rem;
  }
  .schedule-item p {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .back-link {
    padding: 2rem 0 1rem;
  }
  .back-link a {
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: color var(--transition);
  }
  .back-link a:hover {
    color: var(--accent-bright);
  }

  @media (max-width: 980px) {
    .speaker-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .speaker-card {
      grid-template-columns: 1fr;
    }
    .speaker-image,
    .speaker-image img {
      min-height: 300px;
    }
    .schedule-item {
      grid-template-columns: 72px 1fr;
      gap: 0.9rem;
      padding: 0.95rem 1rem;
    }
  }
</style>
