---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/paths";

const newsItems = [
  {
    date: "2026-06-21",
    title: "Final proposal details reflected on the website",
    author: "PhysWorldAI Organizers",
    summary:
      "The site now reflects the final PDF: PhysWorldAI, half-day format, 8 organizers, 4 planned invited speakers, and 2077AI plus CyberBrain sponsorship.",
    tag: "Proposal",
  },
  {
    date: "August 29, 2026",
    title: "Submission deadline",
    author: "Program Committee",
    summary:
      "The proposal plans long papers up to 8 pages and extended abstracts up to 4 pages, reviewed double-blind through OpenReview.",
    tag: "CFP",
  },
  {
    date: "September 26, 2026",
    title: "Notification deadline",
    author: "Program Committee",
    summary:
      "Notifications are scheduled for September 26, 2026, aligned with the NeurIPS hard contributor-decision deadline.",
    tag: "Review",
  },
  {
    date: "October 26, 2026",
    title: "Camera-ready deadline",
    author: "Workshop Team",
    summary:
      "Accepted non-archival papers are posted on the workshop website, while authors remain free to revise and submit elsewhere.",
    tag: "Program",
  },
];
---

<Layout title="Updates | PhysWorldAI" description="Updates for the PhysWorldAI workshop proposal.">
  <Nav currentPage="/news" />

  <section class="hero-small">
    <div class="hero-small-bg" aria-hidden="true"></div>
    <div class="hero-small-content container">
      <p class="eyebrow reveal">Workshop proposal updates</p>
      <h1 class="reveal">Updates</h1>
      <p class="lead reveal">Proposal status, call-for-papers dates, program notes, and workshop announcements.</p>
      <div class="cta-row reveal">
        <a class="btn ghost" href={withBase()}>Home</a>
        <a class="btn ghost" href={withBase("cfp")}>Proposal</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading title="Recent Updates" subtitle="Dates and status from the final proposal" />

      <div class="news-grid">
        {newsItems.map((item) => (
          <article class="news-card glass reveal">
            <div class="news-meta">
              <span class="news-date">{item.date}</span>
              <span class="news-tag">{item.tag}</span>
            </div>
            <h3 class="news-title">{item.title}</h3>
            <p class="news-author muted">{item.author}</p>
            <p class="news-summary">{item.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="container">
    <div class="back-link reveal">
      <a href={withBase()}>Back to main site</a>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  .hero-small {
    position: relative;
    padding: 10rem 0 5rem;
    overflow: hidden;
    text-align: center;
  }

  .hero-small-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgba(105, 214, 200, 0.1), transparent 42%),
      linear-gradient(225deg, rgba(255, 143, 122, 0.08), transparent 46%);
    z-index: 0;
  }

  .hero-small-content {
    position: relative;
    z-index: 1;
    max-width: 760px;
  }

  .eyebrow {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .hero-small h1 {
    margin-bottom: 1.25rem;
    background: linear-gradient(135deg, var(--text) 30%, var(--mint) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lead {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 2rem;
    line-height: 1.75;
  }

  .cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.2rem;
    max-width: 1080px;
    margin: 0 auto;
  }

  .news-card {
    display: flex;
    flex-direction: column;
    transition: transform var(--transition), border-color var(--transition);
  }
  .news-card:hover {
    transform: translateY(-4px);
    border-color: rgba(105, 214, 200, 0.24);
  }

  .news-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .news-date {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .news-tag {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: rgba(105, 214, 200, 0.1);
    color: var(--mint);
    border: 1px solid rgba(105, 214, 200, 0.18);
  }

  .news-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    color: var(--text);
  }

  .news-author {
    font-size: 0.88rem;
    margin-bottom: 0.85rem;
  }

  .news-summary {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
    flex: 1;
  }

  .back-link {
    padding: 2rem 0 1rem;
  }
  .back-link a {
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: color var(--transition);
  }
  .back-link a:hover {
    color: var(--accent-bright);
  }
</style>
