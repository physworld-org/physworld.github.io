---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/paths";

const newsItems = [
  { date: "Proposal Draft", title: "PhysWorld workshop proposal prepared", author: "PhysWorld Organizers", summary: "The proposal frames physical world understanding around geometry, characteristics, and multimodal sensing.", tag: "Proposal" },
  { date: "Planned", title: "OpenReview submission process", author: "Program Committee", summary: "The proposal plans double-blind review, at least 3 reviewers per paper, and non-archival posting of accepted work.", tag: "Review" },
  { date: "Planned", title: "Posters and live demos", author: "Workshop Team", summary: "The proposed full-day schedule includes posters, live sensing demos, invited talks, contributed orals, and a synthesis panel.", tag: "Program" },
];
---

<Layout title="Updates | PhysWorld" description="Updates for the PhysWorld workshop proposal.">
  <Nav currentPage="/news" />

  <!-- Mini Hero -->
  <section class="hero-small">
    <div class="hero-small-bg" aria-hidden="true"></div>
    <div class="hero-small-content container">
      <p class="eyebrow reveal">Workshop proposal updates</p>
      <h1 class="reveal">Updates</h1>
      <p class="lead reveal">
        Proposal status, program notes, and future workshop announcements.
      </p>
      <div class="cta-row reveal">
        <a class="btn ghost" href={withBase()}>Home</a>
        <a class="btn ghost" href={withBase("#contact")}>Contact</a>
      </div>
    </div>
  </section>

  <!-- News Grid -->
  <section class="section">
    <div class="container">
      <SectionHeading title="Recent Updates" subtitle="Current proposal-stage information" />

      <div class="news-grid">
        {newsItems.map((item) => (
          <article class="news-card glass reveal">
            <div class="news-meta">
              <span class="news-date">{item.date}</span>
              <span class="news-tag">{item.tag}</span>
            </div>
            <h3 class="news-title">{item.title}</h3>
            <p class="news-author muted">{item.author}</p>
            <p class="news-summary">{item.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="container">
    <div class="back-link reveal">
      <a href={withBase()}>Back to main site</a>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  /* Mini hero */
  .hero-small {
    position: relative;
    padding: 10rem 0 5rem;
    overflow: hidden;
    text-align: center;
  }

  .hero-small-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 20%, rgba(100, 224, 200, 0.08) 0%, transparent 70%);
    z-index: 0;
  }

  .hero-small-content {
    position: relative;
    z-index: 1;
    max-width: 760px;
  }

  .eyebrow {
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .hero-small h1 {
    margin-bottom: 1.25rem;
    background: linear-gradient(135deg, var(--text) 30%, var(--mint) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lead {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 2rem;
    line-height: 1.75;
  }

  .cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* News grid */
  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .news-card {
    display: flex;
    flex-direction: column;
    transition: all var(--transition);
  }
  .news-card:hover {
    transform: translateY(-5px);
    border-color: rgba(100, 224, 200, 0.2);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.3);
  }

  .news-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .news-date {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .news-tag {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border-radius: 20px;
    background: rgba(100, 224, 200, 0.1);
    color: var(--mint);
    border: 1px solid rgba(100, 224, 200, 0.15);
  }

  .news-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    color: var(--text);
  }

  .news-author {
    font-size: 0.88rem;
    margin-bottom: 0.85rem;
  }

  .news-summary {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
    flex: 1;
  }

  /* Back link */
  .back-link {
    padding: 2rem 0 1rem;
  }
  .back-link a {
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: color var(--transition);
  }
  .back-link a:hover {
    color: var(--accent-bright);
  }

  @media (max-width: 768px) {
    .news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
