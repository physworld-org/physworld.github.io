---

<Layout title="PhysWorld - Physical World Understanding" description="NeurIPS 2026 workshop proposal on physical world understanding through geometry, characteristics, and multimodal sensing.">
  <Nav currentPage="/" />

  <!-- ═══════════════════════ HERO ═══════════════════════ -->
  <section class="hero" aria-label="Hero">
    <div class="hero-backdrop" aria-hidden="true">
      <img src="/assets/teaser_gwm.png" alt="" />
    </div>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="hero-radial" aria-hidden="true"></div>

    <div class="hero-content container">
      <p class="eyebrow reveal">NeurIPS 2026 workshop proposal</p>
      <h1 class="reveal">Physical World Understanding</h1>
      <p class="lead reveal">
        Beyond pixels: understanding the physical world through geometry, dynamics, characteristics, and multimodal sensing.
      </p>
      <div class="cta-row reveal">
        <a class="btn primary" href="/cfp">Workshop Proposal</a>
        <a class="btn ghost" href="#organizers">Meet Organizers</a>
        <a class="btn ghost" href="/speakers">Invited Speakers</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ OVERVIEW ═══════════════════════ -->
  <section id="overview" class="section">
    <div class="container">
      <SectionHeading title="Proposal Overview" />
      <div class="glass reveal overview-content">
        <p>
          <strong>PhysWorld</strong> is a proposed 1st Workshop on Physical World Understanding: Geometry,
          Characteristics, and Multimodal Sensing. The proposal asks how AI systems can perceive, represent,
          and reason about the physical world beyond visual appearance.
        </p>
        <p>
          The workshop centers on three coupled pillars: physical geometry, physical characteristics, and physical
          sensors. It is designed to bring together computer vision, robotics, graphics, multimodal learning,
          haptics, audio, and physics-based simulation communities before their benchmarks and protocols fragment.
        </p>
        <p>
          The proposed full-day format includes invited talks with moderated Q&A, contributed-paper orals,
          posters with live demos, and a synthesis panel spanning geometry, dynamics, materials, and sensing.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ OPPORTUNITIES ═══════════════════════ -->
  <section id="opportunities" class="section">
    <div class="container">
      <div class="highlight-box reveal">
        <div class="highlight-badge">Proposal Snapshot</div>
        <p>
          NeurIPS 2026 workshop, full-day format, expected attendance of 200-300 researchers,
          non-archival submissions, livestreaming and recording requested, and a program designed around discussion
          across geometry, characteristics, and multimodal sensing.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ ANNOUNCEMENT ═══════════════════════ -->
  <section id="announcement" class="section">
    <div class="container">
      <div class="highlight-box highlight-box--accent reveal">
        <div class="highlight-badge">Topics</div>
        <ul class="topic-list">
          <li><strong>Physical Geometry:</strong> 3D/4D reconstruction, articulated and deformable scene understanding, and geometry-aware world models.</li>
          <li><strong>Physical Characteristics:</strong> material properties, contact-rich interactions, dynamics, deformability, affordances, and differentiable simulation.</li>
          <li><strong>Physical Sensors:</strong> tactile, force/torque, proprioception, RF, audio, depth, IMU, event-based signals, and sensor fusion.</li>
          <li><strong>Cross-cutting:</strong> embodied world models, sim-to-real transfer, multimodal simulators, benchmarks, evaluation, and responsible deployment.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ ORGANIZERS ═══════════════════════ -->
  <section id="organizers" class="section">
    <div class="container">
      <SectionHeading title="Team" subtitle="The currently displayed organizers for the PhysWorld proposal" />

      <div class="team-group">
        <h3 class="group-label reveal">Organizers</h3>
        <div class="person-grid reveal-stagger">
          {organizers.map((p) => <PersonCard {...p} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ SPONSORS ═══════════════════════ -->
  <section id="sponsors" class="section">
    <div class="container">
      <SectionHeading title="Sponsors" />
      <div class="sponsor-callout glass reveal">
        <h3>Sponsorship and Awards</h3>
        <p>
          CyberBrain is listed in the proposal as a confirmed sponsor. Sponsor support will fund the Best Paper Award, Best Student Paper Award, student travel grants for underrepresented attendees, and on-site logistics.
        </p>
      </div>
      <div class="sponsor-logos reveal">
        <img src="/assets/sponsor/cyberbrain_new.png" alt="Cyberbrain" class="sponsor-logo" />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ CONTACT ═══════════════════════ -->
  <section id="contact" class="section">
    <div class="container">
      <SectionHeading title="Contact" />
      <div class="glass reveal contact-box">
        <p class="contact-email">
          <a href="mailto:general_world@outlook.com">general_world@outlook.com</a>
        </p>
        <p class="muted">Questions, sponsorship, program committee interest, or proposal coordination.</p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ═══════════════════════ HERO ═══════════════════════ */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding-top: 72px;
  }

  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-backdrop img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.18;
    filter: saturate(0.5) brightness(0.5);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(7, 11, 20, 0.6) 0%,
      rgba(10, 14, 26, 0.85) 50%,
      var(--bg-base) 100%
    );
  }

  .hero-radial {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      ellipse 70% 50% at 50% 40%,
      rgba(79, 164, 212, 0.08) 0%,
      transparent 70%
    );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 800px;
    padding: 4rem 2rem;
  }

  .eyebrow {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }

  .hero h1 {
    margin-bottom: 1.5rem;
    background: linear-gradient(135deg, var(--text) 30%, var(--accent-bright) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lead {
    font-size: 1.2rem;
    color: var(--text-secondary);
    max-width: 620px;
    margin: 0 auto 2.5rem;
    line-height: 1.75;
  }

  .cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ═══════════════════════ OVERVIEW ═══════════════════════ */
  .overview-content p {
    margin-bottom: 1.25rem;
  }
  .overview-content p:last-child {
    margin-bottom: 0;
  }

  /* ═══════════════════════ HIGHLIGHT BOXES ═══════════════════════ */
  .highlight-box {
    background: linear-gradient(135deg, rgba(79, 164, 212, 0.06) 0%, rgba(100, 224, 200, 0.04) 100%);
    border: 1px solid rgba(79, 164, 212, 0.15);
    border-radius: var(--radius);
    padding: 2.5rem;
    text-align: center;
    max-width: 780px;
    margin: 0 auto;
    transition: all var(--transition);
  }
  .highlight-box:hover {
    border-color: rgba(79, 164, 212, 0.3);
    box-shadow: 0 0 40px rgba(79, 164, 212, 0.08);
  }

  .highlight-box--accent {
    background: linear-gradient(135deg, rgba(100, 224, 200, 0.06) 0%, rgba(79, 164, 212, 0.04) 100%);
    border-color: rgba(100, 224, 200, 0.15);
  }
  .highlight-box--accent:hover {
    border-color: rgba(100, 224, 200, 0.3);
    box-shadow: 0 0 40px rgba(100, 224, 200, 0.08);
  }

  .highlight-badge {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--accent-bright);
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
  }

  .highlight-box--accent .highlight-badge {
    color: var(--mint);
  }

  .highlight-box p {
    font-size: 1.05rem;
    line-height: 1.75;
    max-width: 640px;
    margin: 0 auto;
  }

  /* ═══════════════════════ TEAM / PEOPLE ═══════════════════════ */
  .team-group {
    margin-bottom: 3.5rem;
  }
  .team-group:last-child {
    margin-bottom: 0;
  }

  .group-label {
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent);
    margin-bottom: 2rem;
    position: relative;
  }

  .group-label::after {
    content: "";
    display: block;
    width: 36px;
    height: 2px;
    background: var(--accent);
    margin: 0.6rem auto 0;
    border-radius: 1px;
    opacity: 0.5;
  }

  .person-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: 1.5rem;
    width: 100%;
  }

  /* ═══════════════════════ SPONSORS ═══════════════════════ */
  .sponsor-callout {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }
  .sponsor-callout h3 {
    font-family: var(--font-display);
    color: var(--accent-bright);
    margin-bottom: 1rem;
  }
  .sponsor-callout p {
    line-height: 1.75;
  }

  .sponsor-logos {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    margin-top: 2.5rem;
    flex-wrap: wrap;
  }

  .sponsor-logo {
    height: 120px;
    width: auto;
    opacity: 0.9;
    filter: brightness(1.2) grayscale(0.15);
    transition: all var(--transition);
    padding: 1.25rem 2.5rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
  }
  .sponsor-logo:hover {
    opacity: 1;
    filter: brightness(1.4) grayscale(0);
    transform: scale(1.05) translateY(-4px);
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(79, 164, 212, 0.2);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25),
                0 0 20px var(--accent-glow);
  }

  /* ═══════════════════════ CONTACT ═══════════════════════ */
  .contact-box {
    text-align: center;
    max-width: 500px;
    margin: 0 auto;
  }

  .contact-email {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .contact-email a {
    font-weight: 600;
    color: var(--accent-bright);
  }

  /* ═══════════════════════ RESPONSIVE ═══════════════════════ */
  @media (max-width: 768px) {
    .hero-content {
      padding: 3rem 1.25rem;
    }
    .lead {
      font-size: 1.05rem;
    }
    .highlight-box {
      padding: 1.75rem;
    }
    .person-grid {
      justify-content: center;
    }
  }


  .topic-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .topic-list li {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--glass-border);
    color: var(--text-secondary);
    line-height: 1.7;
  }
  .topic-list li:last-child {
    border-bottom: none;
  }
</style>
