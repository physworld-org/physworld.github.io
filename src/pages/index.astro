    affiliation: "Lister Brothers Career Development Associate Professor, MIT",
    image: "/assets/profile_organizer/ashia.png",
    url: "https://www.ashiawilson.com/",
  },
  {
    name: "Paul Liang",
    affiliation: "Assistant Professor, MIT Media Lab and MIT EECS",
    image: "/assets/profile_speaker/paul.jpg",
    url: "https://pliang279.github.io/",
  },
  {
    name: "Mengyu Wang",
    affiliation: "Associate Professor of Ophthalmology, Harvard Medical School",
    image: "/assets/profile_organizer/mengyu.jpg",
    url: "https://wang.hms.harvard.edu/team/dr-wang/",
  },
  {
    name: "Shangzhe Wu",
    affiliation: "Assistant Professor, Department of Engineering, University of Cambridge",
    image: "/assets/profile_organizer/shangzhe.jpg",
    url: "https://www.elliottwu.com/",
  },
];

