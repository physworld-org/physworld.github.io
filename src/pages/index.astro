---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import PersonCard from "../components/PersonCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/paths";
import { organizers, schedule, speakers, sponsors, topics, workshop } from "../data/workshop";

const organizerCards = organizers.map((person) => ({
  ...person,
  image: person.image ? withBase(person.image) : undefined,
}));

const primaryOrganizerCards = organizerCards.filter((person) => person.tag !== "Junior Organizer");
const juniorOrganizerCards = organizerCards.filter((person) => person.tag === "Junior Organizer");

const speakerCards = speakers.map((person) => ({
  name: person.name,
  affiliation: person.affiliation,
  tag: person.pillar,
  focus: person.title,
  image: withBase(person.image),
  url: person.url,
}));

const sponsorCards = sponsors.map((sponsor) => ({
  ...sponsor,
  image: withBase(sponsor.image),
}));

const stats = [
  { value: workshop.edition, label: "Workshop edition" },
  { value: workshop.format, label: "Workshop format" },
  { value: workshop.location, label: "Location" },
  { value: workshop.displayDates, label: "NeurIPS 2026 dates" },
];

const keyDates = workshop.dates;
---

<Layout title="PhysWorldAI - Physical World AI" description={workshop.tagline}>
  <Nav currentPage="/" />

  <section class="hero" aria-label="Hero">
    <div class="hero-backdrop" aria-hidden="true">
      <img src={withBase("assets/teaser_gwm.png")} alt="" />
    </div>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="hero-lines" aria-hidden="true"></div>

    <div class="hero-content container">
      <p class="eyebrow reveal">NeurIPS 2026 Workshop | Atlanta, Georgia | December 8-13, 2026</p>
      <h1 class="reveal">{workshop.title}</h1>
      <p class="lead reveal">{workshop.tagline}</p>
      <div class="cta-row reveal">
        <a class="btn primary" href={withBase("cfp")}>Call for Papers</a>
        <a class="btn ghost" href={withBase("speakers")}>Invited Speakers</a>
        <a class="btn ghost" href="#organizers">Organizers</a>
      </div>
    </div>
  </section>

  <section id="overview" class="section">
    <div class="container">
      <SectionHeading title={workshop.shortName} subtitle={workshop.name} />
      <div class="overview-layout">
        <div class="glass reveal overview-content">
          <p>
            <strong>{workshop.shortName}</strong> is the first workshop on physical world AI, centered on
            the question of how AI systems can perceive, represent, and reason about the physical world beyond
            appearance.
          </p>
          <p>
            The workshop program is organized around three coupled pillars: physical geometry, physical
            characteristics, and physical sensors. It brings together computer vision, robotics, graphics, multimodal
            learning, haptics, audio, and physics-based simulation communities before benchmarks and protocols
            fragment across separate venues.
          </p>
          <p>
            The half-day program includes moderated Q&A, contributed-paper spotlights, posters, live demos,
            and a synthesis panel across geometry, characteristics, sensing, and embodied AI in Atlanta, Georgia.
          </p>
        </div>
        <div class="snapshot reveal">
          {stats.map((item) => (
            <div class="stat-card">
              <span>{item.value}</span>
              <p>{item.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="topics" class="section section-alt">
    <div class="container">
      <SectionHeading title="Topics" subtitle="Geometry, characteristics, sensors, and cross-cutting physical AI" />
      <div class="topic-grid reveal-stagger">
        {topics.map((topic) => (
          <article class="topic-card">
            <h3>{topic.title}</h3>
            <p>{topic.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="program" class="section">
    <div class="container">
      <SectionHeading title="Half-Day Program" subtitle="Workshop program" />
      <div class="schedule-list reveal">
        {schedule.map((item) => (
          <div class="schedule-item">
            <time>{item.time}</time>
            <div>
              <h3>{item.title}</h3>
              {item.detail && <p>{item.detail}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="dates" class="section section-alt">
    <div class="container">
      <SectionHeading title="Key Dates" subtitle={`${workshop.location}, ${workshop.eventDates}`} />
      <div class="date-grid reveal-stagger">
        {keyDates.map((date) => (
          <article class="date-card">
            <span>{date.label}</span>
            <strong>{date.display}</strong>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="speakers" class="section">
    <div class="container">
      <SectionHeading title="Invited Speakers" subtitle="Four invited speakers spanning physical simulation, geometry, embodied intelligence, and multimodal perception" />
      <div class="speaker-plan-grid reveal-stagger">
        {speakerCards.map((person) => <PersonCard {...person} class="speaker-card-large" />)}
      </div>
      <div class="center-link reveal">
        <a href={withBase("speakers")}>View speaker details</a>
      </div>
    </div>
  </section>

  <section id="organizers" class="section section-alt">
    <div class="container">
      <SectionHeading title="Organizers" subtitle="Organizing team for PhysWorldAI" />
      <div class="organizer-grid organizer-primary-grid reveal-stagger">
        {primaryOrganizerCards.map((person) => <PersonCard {...person} class="organizer-card-compact" />)}
      </div>

      <h3 class="organizer-group-title reveal">Junior Organizers</h3>
      <div class="organizer-grid junior-organizer-grid reveal-stagger">
        {juniorOrganizerCards.map((person) => <PersonCard {...person} class="organizer-card-compact" />)}
      </div>
    </div>
  </section>

  <section id="sponsors" class="section">
    <div class="container">
      <SectionHeading title="Sponsors" subtitle="Sponsor support for PhysWorldAI" />
      <div class="sponsor-intro glass reveal">
        <h3>Sponsorship and Awards</h3>
        <p>
          Sponsor support is allocated to the Overall Best Paper Award, Best Student Paper Award, student travel
          grants for underrepresented attendees, and on-site logistics.
        </p>
      </div>
      <div class="sponsor-logos reveal-stagger">
        {sponsorCards.map((sponsor) => (
          <a class="sponsor-logo-card" href={sponsor.url} target="_blank" rel="noopener noreferrer" aria-label={sponsor.name}>
            <img src={sponsor.image} alt={sponsor.name} />
            <span>{sponsor.commitment}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="section">
    <div class="container">
      <SectionHeading title="Contact" />
      <div class="glass reveal contact-box">
        <p class="contact-email">
          <a href="mailto:zhouk777@mit.edu">zhouk777@mit.edu</a>
        </p>
        <p class="muted">Questions, sponsorship, program committee interest, or workshop coordination.</p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding-top: 72px;
  }

  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-backdrop img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.2;
    filter: saturate(0.7) contrast(1.05) brightness(0.65);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(8, 9, 13, 0.58) 0%, rgba(12, 13, 17, 0.78) 55%, var(--bg-base) 100%),
      linear-gradient(115deg, rgba(243, 179, 93, 0.12), transparent 38%, rgba(105, 214, 200, 0.08));
  }

  .hero-lines {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.22;
    background-image: linear-gradient(115deg, transparent 0 18%, rgba(255, 255, 255, 0.16) 18.2%, transparent 18.6% 100%);
    background-size: 360px 100%;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 880px;
    padding: 4rem 2rem;
  }

  .eyebrow {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }

  .hero h1 {
    margin-bottom: 1.5rem;
    background: linear-gradient(135deg, var(--text) 20%, var(--accent-bright) 60%, var(--mint) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lead {
    font-size: 1.2rem;
    color: var(--text-secondary);
    max-width: 660px;
    margin: 0 auto 2.5rem;
    line-height: 1.75;
  }

  .cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .section-alt {
    background: rgba(255, 255, 255, 0.018);
    border-block: 1px solid rgba(255, 255, 255, 0.035);
  }

  .overview-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: 1.5rem;
    align-items: stretch;
  }

  .overview-content p {
    margin-bottom: 1.25rem;
  }
  .overview-content p:last-child {
    margin-bottom: 0;
  }

  .snapshot {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .stat-card,
  .topic-card {
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  .stat-card span {
    display: block;
    color: var(--accent-bright);
    font-weight: 800;
    font-size: 1.2rem;
    line-height: 1.35;
  }
  .stat-card p {
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .topic-card h3 {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--accent-bright);
    margin-bottom: 0.65rem;
  }

  .topic-card p {
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .schedule-list {
    max-width: 860px;
    margin: 0 auto;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--glass);
  }

  .schedule-item {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 1.25rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--glass-border);
    align-items: center;
  }
  .schedule-item:last-child {
    border-bottom: none;
  }
  .schedule-item time {
    color: var(--accent-bright);
    font-weight: 800;
    font-size: 0.95rem;
  }
  .schedule-item h3 {
    font-family: var(--font-body);
    font-size: 1rem;
    margin-bottom: 0.1rem;
  }
  .schedule-item p {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .date-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    max-width: 940px;
    margin: 0 auto;
  }

  .date-card {
    min-height: 138px;
    padding: 1.4rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.025));
  }
  .date-card span {
    display: block;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }
  .date-card strong {
    color: var(--accent-bright);
    font-size: 1.25rem;
    line-height: 1.35;
  }

  .person-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: 1.2rem;
    width: 100%;
  }

  .organizer-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
  }

  .junior-organizer-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 820px;
  }

  .organizer-group-title {
    margin: 3.25rem 0 1.4rem;
    text-align: center;
    color: var(--accent-bright);
    font-size: clamp(1.4rem, 2vw, 1.8rem);
  }

  /* A lone card on the final row sits centred instead of hugging the left edge. */
  :global(.organizer-primary-grid > .person-card:last-child:nth-child(4n + 1)) {
    grid-column: 2 / span 2;
    justify-self: center;
    width: 100%;
    max-width: calc((1160px - 3rem) / 4);
  }

  /* Two cards left over: shift them inward so the row stays balanced. */
  :global(.organizer-primary-grid > .person-card:nth-last-child(2):nth-child(4n + 1)) {
    grid-column: 2;
  }

  .center-link {
    text-align: center;
    margin-top: 2rem;
  }
  .center-link a {
    color: var(--accent-bright);
    font-weight: 700;
  }

  .sponsor-intro {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }
  .sponsor-intro h3 {
    color: var(--accent-bright);
    margin-bottom: 1rem;
  }

  .sponsor-logos {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .sponsor-logo-card {
    width: min(320px, 100%);
    min-height: 150px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 1.25rem 2rem;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .sponsor-logo-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.28);
  }
  .sponsor-logo-card img {
    max-width: 230px;
    max-height: 82px;
    object-fit: contain;
  }
  .sponsor-logo-card span {
    color: #2d2a24;
    font-weight: 800;
    font-size: 0.9rem;
  }

  .contact-box {
    text-align: center;
    max-width: 500px;
    margin: 0 auto;
  }

  .contact-email {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .contact-email a {
    font-weight: 700;
    color: var(--accent-bright);
  }

  @media (max-width: 980px) {
    .overview-layout,
    .topic-grid {
      grid-template-columns: 1fr 1fr;
    }
    .date-grid {
      grid-template-columns: 1fr;
    }
    .organizer-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    /* Three columns again, so re-centre by thirds instead of by quarters. */
    :global(.organizer-primary-grid > .person-card:last-child:nth-child(4n + 1)),
    :global(.organizer-primary-grid > .person-card:nth-last-child(2):nth-child(4n + 1)) {
      grid-column: auto;
      justify-self: stretch;
      width: 100%;
      max-width: none;
    }
    :global(.organizer-primary-grid > .person-card:last-child:nth-child(3n + 1)) {
      grid-column: 2;
    }
  }

  @media (max-width: 680px) {
    .hero-content {
      padding: 3rem 1.25rem;
    }
    .lead {
      font-size: 1.05rem;
    }
    .overview-layout,
    .snapshot,
    .topic-grid {
      grid-template-columns: 1fr;
    }
    .schedule-item {
      grid-template-columns: 72px 1fr;
      gap: 0.9rem;
      padding: 0.95rem 1rem;
    }
    .organizer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .junior-organizer-grid {
      max-width: 100%;
    }
    :global(.organizer-primary-grid > .person-card:last-child:nth-child(4n + 1)),
    :global(.organizer-primary-grid > .person-card:nth-last-child(2):nth-child(4n + 1)),
    :global(.organizer-primary-grid > .person-card:last-child:nth-child(3n + 1)) {
      grid-column: auto;
      justify-self: stretch;
      width: 100%;
      max-width: none;
    }
  }

  @media (max-width: 430px) {
    .organizer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  .speaker-plan-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
    max-width: 700px;
    margin: 0 auto;
  }

  @media (max-width: 760px) {
    .speaker-plan-grid {
      grid-template-columns: 1fr;
      max-width: 340px;
    }
  }
</style>
